{
    "name": "ramanbasu-business/opencart-php-plugin",
    "description": "Legacy OpenCart connector for product, order and inventory synchronisation.",
    "type": "project",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.0",
        "phpstan/phpstan": "^1.0"
    },
    "scripts": {
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "phpcs": "phpcs --standard=phpcs.xml.dist src/system/library/scoc_utility.php tests",
        "phpstan": "phpstan analyse -c phpstan.neon.dist src/system/library/scoc_utility.php tests --memory-limit=1G",
        "test": "phpunit --bootstrap tests/bootstrap.php tests",
        "quality": [
            "@lint",
            "@phpcs",
            "@phpstan",
            "@test"
        ]
    }
}
